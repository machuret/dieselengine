---
import Page from '../layouts/Page.astro';
import ProviderDirectory from '../components/ProviderDirectory.astro';
import { allPages } from '../lib/content.js';

export function getStaticPaths() {
  const byUrl = new Map(allPages.map((p) => [p.url, p]));
  return allPages.map((page) => ({
    // Astro's catch-all wants the path without leading/trailing slashes;
    // trailingSlash:'always' + format:'directory' re-adds them on output.
    params: { slug: page.url.replace(/^\/|\/$/g, '') },
    props: { page: { ...page, parentTitle: byUrl.get(page.parent)?.title } },
  }));
}

const { page } = Astro.props;
const { Content } = page;
---
<Page page={page}>
  {page.url === '/find-a-marine-mechanic/' ? (
    <>
      <p class="kicker">Verified Australian directory</p>
      <h1>Find a marine diesel mechanic in Australia</h1>
      <p class="lead">Start with a current provider listing, then use the detailed trade, pricing and booking guide below to choose the right specialist.</p>
      <ProviderDirectory />
      <div class="mechanic-details"><Content /></div>
    </>
  ) : <Content />}
</Page>
