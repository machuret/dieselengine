---
import site from '../../site.config.json' with { type: 'json' };
import { allPages } from '../lib/content.js';

const canonical = `${site.domain}/`;
const pillars = ['/marine-diesel-engines/', '/marine-engine-problems/', '/find-a-marine-mechanic/', '/costs/', '/engine-brands/']
  .map((u) => allPages.find((p) => p.url === u))
  .filter(Boolean);
const cities = allPages.filter((p) => p.pageType === 'city-hub');
const services = allPages.filter((p) => p.pageType === 'service-national');
const ready = allPages.filter((p) => p.indexable).length;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.domain}/#publisher`, name: site.name, url: site.domain, description: site.description },
    { '@type': 'WebSite', url: canonical, name: site.name, inLanguage: site.locale, publisher: { '@id': `${site.domain}/#publisher` } },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name} — {site.tagline}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={ready > 0 ? 'index, follow' : 'noindex, follow'} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="brand" href="/">{site.shortName}</a>
      <nav aria-label="Primary">
        <a href="/marine-diesel-engines/">Marine engines</a>
        <a href="/marine-engine-problems/">Problems</a>
        <a href="/services/">Services</a>
        <a href="/costs/">Costs</a>
        <a href="/find-a-marine-mechanic/">Find a mechanic</a>
      </nav>
    </header>

    {ready === 0 && (
      <div class="draft-banner" role="status">
        <strong>No page has been published yet.</strong> Every page is served
        <code>noindex</code> and the sitemap is empty until pages clear their
        publish checks. See <code>docs/deployment.md</code>.
      </div>
    )}

    <main id="main">
      <article class="prose">
        <h1>Marine diesel engines in Australia</h1>
        <p class="lede">
          Independent guides to how marine diesels work, what goes wrong with
          them, what the work should cost, and how to find a mechanic who knows
          your engine. We don't work on boats and we don't sell parts.
        </p>

        <h2>Start here</h2>
        <ul class="cards">
          {pillars.map((p) => (
            <li><a href={p.url}><strong>{p.title}</strong></a></li>
          ))}
        </ul>

        <h2>Find a marine mechanic near you</h2>
        <p>{cities.map((p, i) => (<>{i > 0 && ' · '}<a href={p.url}>{p.title.replace('Marine Diesel Mechanics in ', '')}</a></>))}</p>

        <h2>Services</h2>
        <p>{services.map((p, i) => (<>{i > 0 && ' · '}<a href={p.url}>{p.title.replace(' in Australia', '')}</a></>))}</p>
      </article>
    </main>

    <footer class="site">
      <p><strong>{site.name}</strong> is an independent information site. We do not work on boats, sell parts, or perform any of the work described here.</p>
    </footer>
  </body>
</html>
