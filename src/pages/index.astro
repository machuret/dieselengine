---
import site from '../../site.config.json' with { type: 'json' };
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { allPages } from '../lib/content.js';
import { seoTitle } from '../lib/extract.js';

const canonical = `${site.domain}/`;
const ready = allPages.filter((p) => p.indexable).length;

// Ordered by urgency, then by how often people arrive with them.
// Severity is data, not a CSS nth-child guess. Getting this wrong is the one
// thing on this site that could hurt someone, so the page that renders it
// should not be inferring urgency from row order.
const TRIAGE = [
  { url: '/marine-engine-problems/no-water-from-exhaust/',
    q: 'No water from the exhaust', a: 'Shut down now', sev: 'stop' },
  { url: '/marine-engine-problems/marine-engine-overheating/',
    q: 'Running hot or overheating', a: 'Shut down now', sev: 'stop' },
  { url: '/marine-engine-problems/saltwater-in-engine-oil/',
    q: 'Saltwater in the oil', a: 'Act within hours', sev: 'urgent' },
  { url: '/marine-engine-problems/marine-engine-loses-power/',
    q: 'Loses power under load', a: 'Often the hull', sev: 'check' },
  { url: '/marine-engine-problems/marine-engine-black-smoke/',
    q: 'Blowing black smoke', a: 'Usually overloaded', sev: 'check' },
  { url: '/marine-engine-problems/marine-engine-wont-start/',
    q: "Won't start", a: 'Batteries or fuel', sev: 'check' },
];

const PILLARS = [
  { url: '/marine-engine-problems/', t: 'Something is wrong',
    d: 'Start from the symptom. Likely causes ranked by how often they turn out to be the answer — and whether it is safe to keep going.' },
  { url: '/costs/', t: 'What it should cost',
    d: 'Real Australian price ranges, split into parts and labour, with the access assumption stated. Know the number before you call.' },
  { url: '/services/', t: 'What the job involves',
    d: 'Impellers, heat exchangers, exhaust elbows, gearboxes, repowers. What each job actually is and how to tell a complete quote from a cheap one.' },
  { url: '/marine-diesel-engines/', t: 'How marine diesels work',
    d: 'Raw water cooling, wet exhaust, electrochemical corrosion, and the months of idle time that cause most failures.' },
  { url: '/engine-brands/', t: 'Your engine',
    d: 'Volvo Penta, Yanmar, Cummins, Caterpillar — and the Kubota blocks under Beta, Nanni and Solé.' },
  { url: '/find-a-marine-mechanic/', t: 'Find a mechanic',
    d: 'Which trade does which job, what to ask before booking, and verified operators by marina.' },
];

const locations = allPages.filter((p) => p.pageType === 'city-hub');
const services = allPages.filter((p) => p.pageType === 'service-national');
const featuredServices = services.slice(0, 12);
const socialImage = new URL(site.socialImage, site.domain).href;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.domain}/#publisher`, name: site.name, url: site.domain, description: site.description },
    { '@type': 'WebSite', url: canonical, name: site.name, inLanguage: site.locale, publisher: { '@id': `${site.domain}/#publisher` } },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle({ seoTitle: 'Marine Diesel Engine Guides, Costs & Mechanics Australia' }, site.shortName)}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={ready > 0 ? 'index, follow' : 'noindex, follow'} />
    <meta name="theme-color" content="#0d6273" />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Marine diesel engine installed in a yacht engine bay" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />

    <main id="main">
      <section class="hero deep-band">
       <div class="hero-inner">
        <div class="hero-main">
          <p class="eyebrow"><span class="rule-dash" aria-hidden="true"></span>Independent · Australia · {ready} pages</p>
          <h1>Something wrong with your engine?</h1>
          <p class="hero-lede">
            Independent Australian guides to marine diesels: what the symptom
            means, what the repair should cost, and how to find a mechanic who
            knows your engine.
          </p>
          <p class="hero-note">
            We don't work on boats and we don't sell parts. Nothing here is
            trying to win your job.
          </p>
        </div>

        {/* The most characteristic thing in this subject's world is triage:
            most people arrive mid-problem. Let them start from the symptom
            here rather than navigate to it. */}
        <aside class="triage" aria-labelledby="triage-h">
          <h2 id="triage-h">Start with the symptom</h2>
          <ul>
            {TRIAGE.map((t) => (
              <li data-sev={t.sev}>
                <a href={t.url}>
                  <span class="q">{t.q}</span>
                  <span class="a">{t.a}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="all"><a href="/marine-engine-problems/">All 35 symptoms <span aria-hidden="true">&rarr;</span></a></p>
        </aside>
       </div>
      </section>

      {site.heroFigure && (
        /* Keep the engine visible without putting text over busy machinery.
           The photograph follows the urgent triage panel, where it adds
           context without delaying the reader's route to safety advice. */
        <figure class="blueprint">
          <div class="blueprint-frame" role="group"
               aria-label="Marine diesel engine installation photograph">
            <img src={site.heroFigure.src} alt={site.heroFigure.alt}
                 width="1672" height="941" fetchpriority="high" decoding="async" />
          </div>
          <figcaption>{site.heroFigure.caption}</figcaption>
        </figure>
      )}

      <section class="trust-strip wrap" aria-label="What you will find here">
        <p><strong>Independent advice</strong><span>No repair shop, parts sales or hidden pitch.</span></p>
        <p><strong>Australian context</strong><span>Local labour, marina access and price ranges.</span></p>
        <p><strong>Safety first</strong><span>Clear stop-now warnings before troubleshooting.</span></p>
      </section>

      {/* Six identical rounded cards in a 2-up grid was the most generic thing
          on this page, and it flattened urgency: "Something is wrong" looked
          exactly like "How marine diesels work". A numbered register borrows
          the drawing-sheet index the subject already uses, and lets the first
          two entries carry visible weight. */}
      <ol class="register wrap">
        {PILLARS.map((p, i) => (
          <li>
            <a href={p.url}>
              <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="t">{p.t}</span>
                <span class="d">{p.d}</span>
              </span>
              <span class="go" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ol>

      <section class="field-notes wrap" aria-labelledby="field-notes-h">
        <div class="field-notes-head">
          <div>
            <p class="kicker">From the engine bay</p>
            <h2 id="field-notes-h">Two systems worth checking first</h2>
          </div>
          <p>Cooling and condition checks prevent a small warning sign becoming a tow, a rebuild or a flooded cylinder.</p>
        </div>
        <div class="feature-grid">
          <a class="feature-card" href="/marine-engine-problems/no-water-from-exhaust/">
            <img src="/images/raw-water-strainer-inspection.jpg" width="1200" height="800" loading="lazy" decoding="async" alt="Gloved hands inspecting a marine engine raw-water strainer" />
            <span class="feature-copy"><span class="kicker">Cooling system</span><strong>No water from the exhaust?</strong><span>What to shut down, inspect and clear — in the right order.</span></span>
          </a>
          <a class="feature-card" href="/find-a-marine-mechanic/">
            <img src="/images/marine-mechanic-engine-inspection.jpg" width="1200" height="800" loading="lazy" decoding="async" alt="Marine mechanic inspecting an inboard diesel engine aboard a yacht" />
            <span class="feature-copy"><span class="kicker">Before you book</span><strong>Get a useful diagnosis</strong><span>What to record, what to ask and which marine trade you actually need.</span></span>
          </a>
        </div>
      </section>

      <h2 class="section-head">Find a marine mechanic</h2>
      <p class="section-sub">
        Verified operators by marina and precinct, with the engine brands they
        work on and whether they attend moorings.
      </p>
      <ul class="chips wrap">
        {locations.map((p) => (
          <li><a href={p.url}>{p.title.replace('Marine Diesel Mechanics in ', '')}</a></li>
        ))}
      </ul>

      <h2 class="section-head">Every job, explained</h2>
      <p class="section-sub">
        What the work involves, when you need it, and what it should cost.
      </p>
      <ul class="chips wrap">
        {featuredServices.map((p) => (
          <li><a href={p.url}>{p.title.replace(' in Australia', '')}</a></li>
        ))}
      </ul>
      {services.length > featuredServices.length && (
        <p class="section-more wrap"><a href="/services/">Browse all {services.length} marine diesel services <span aria-hidden="true">&rarr;</span></a></p>
      )}
    </main>

    <SiteFooter />
  </body>
</html>
