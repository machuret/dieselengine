---
import Page from '../layouts/Page.astro';
import site from '../../site.config.json' with { type: 'json' };
const page = {
  url: '/tools/', title: 'Free Marine Diesel Engine Owner Tools',
  seoTitle: 'Marine Diesel Engine Checklists & Owner Tools', pageType: 'tools', status: 'ready',
  author: site.defaultAuthor, reviewer: null, needsReviewer: false, parent: '/', parentTitle: 'Home',
  schema: ['CollectionPage', 'BreadcrumbList'], updated: '2026-10-02', indexable: true, blockers: [],
  headings: [{depth:2,slug:'maintenance-checklist',text:'Maintenance checklist'},{depth:2,slug:'fault-record',text:'Fault evidence record'},{depth:2,slug:'repower-worksheet',text:'Repower measurement worksheet'},{depth:2,slug:'quote-comparator',text:'Quote comparator'},{depth:2,slug:'used-engine-scorecard',text:'Used-engine scorecard'},{depth:2,slug:'service-log',text:'Service log entry'}], faqs: [],
  description: 'Free printable marine diesel engine tools for maintenance, fault records, repower measurements, quote comparison, used-engine inspection and service logs.',
  primaryKeyword: 'marine diesel engine checklist tools', searchIntent: 'Practical informational',
  image: '/images/marine-engine-fault-evidence.jpg', imageAlt: 'Boat owner recording marine diesel engine fault evidence',
  extraSchema: [{ '@type': 'WebApplication', name: 'Marine Diesel Engine Owner Tools', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' } }],
};
const checklist = ['Check engine and bilge for new oil, fuel, coolant or seawater', 'Check oil and coolant against the model manual', 'Open and inspect the raw-water path and strainer', 'Inspect belts, hoses, clamps, mounts and wiring', 'Start and confirm alarms clear and cooling water flows', 'Record charging voltage, temperature and unusual smoke or sound'];
---
<Page page={page}>
  <p class="kicker">Practical owner workspace</p>
  <h1>Marine diesel engine checklists and owner tools</h1>
  <p class="lead">Turn observations into a useful record for maintenance, quotations and diagnosis. Your entries stay in this browser unless you choose to download or print them.</p>
  <figure class="editorial-visual editorial-visual--lead"><img src="/images/marine-engine-fault-evidence.jpg" width="1400" height="933" alt="Boat owner documenting marine engine alarm and operating evidence" fetchpriority="high" /><figcaption>Specific evidence helps a technician understand what happened before components are disturbed.</figcaption></figure>
  <aside class="warning"><strong>Safety:</strong> These tools organise information; they do not diagnose an engine. Shut down for oil-pressure alarms, overheating, fuel spray, smoke in the engine space, loss of cooling-water flow or suspected water entry.</aside>

  <section class="owner-tool" id="maintenance-checklist" data-tool="maintenance"><h2>Maintenance checklist</h2><p>Tick only work you have actually inspected or completed. Print or save the browser page for your records.</p><div class="tool-checks">{checklist.map((item) => <label><input type="checkbox" name={item} /> <span>{item}</span></label>)}</div><label>Engine hours <input type="number" inputmode="decimal" name="engine-hours" placeholder="e.g. 842" /></label><label>Notes <textarea name="notes" rows="3" placeholder="Readings, parts, leaks or follow-up work"></textarea></label><div class="tool-actions"><button type="button" data-save>Save on this device</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>

  <section class="owner-tool" id="fault-record" data-tool="fault-record"><h2>Fault evidence record</h2><p>Capture what happened without repeatedly restarting the engine.</p><div class="tool-grid"><label>Engine model and serial<input name="engine" /></label><label>Engine hours<input name="hours" inputmode="decimal" /></label><label>Date and location<input name="date-location" /></label><label>RPM when it happened<input name="rpm" inputmode="numeric" /></label><label>Alarm or gauge reading<input name="alarm" /></label><label>Smoke colour / exhaust water<input name="exhaust" /></label></div><label>Timeline and observations<textarea name="timeline" rows="5"></textarea></label><div class="tool-actions"><button type="button" data-download>Download record</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>

  <section class="owner-tool" id="repower-worksheet" data-tool="repower"><h2>Repower measurement worksheet</h2><p>Record measurements in millimetres and have the installer validate them against dimensioned drawings.</p><div class="tool-grid"><label>Existing engine and drive<input name="existing-engine" /></label><label>Available length (mm)<input type="number" name="length" /></label><label>Available width (mm)<input type="number" name="width" /></label><label>Available height (mm)<input type="number" name="height" /></label><label>Mount centres (mm)<input type="number" name="mounts" /></label><label>Shaft centre height (mm)<input type="number" name="shaft-height" /></label><label>Exhaust diameter (mm)<input type="number" name="exhaust" /></label><label>Removal opening (mm)<input name="removal" /></label></div><label>Access and system changes<textarea name="notes" rows="4" placeholder="Cooling, exhaust, fuel, electrical, controls, propeller and service clearances"></textarea></label><div class="tool-actions"><button type="button" data-download>Download worksheet</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>

  <section class="owner-tool" id="quote-comparator" data-tool="quotes"><h2>Marine engine quote comparator</h2><p>Compare installed scope, not the headline engine price.</p><div class="table-scroll"><table><thead><tr><th>Quote item</th><th>Supplier A</th><th>Supplier B</th></tr></thead><tbody>{['Engine / service','Drive and ratio','Controls and electrical','Cooling and exhaust','Propeller / alignment','Labour and travel','Haul-out and sea trial','Warranty party','Installed total'].map((row) => <tr><th>{row}</th><td><input aria-label={`${row}, supplier A`} name={`a-${row}`} /></td><td><input aria-label={`${row}, supplier B`} name={`b-${row}`} /></td></tr>)}</tbody></table></div><div class="tool-actions"><button type="button" data-download>Download comparison</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>

  <section class="owner-tool" id="used-engine-scorecard" data-tool="used-engine"><h2>Used marine engine inspection scorecard</h2><p>This is an evidence checklist, not a mechanical verdict. A qualified surveyor or mechanic should perform the technical inspection.</p><div class="tool-checks">{['Identification plates match the records','Engine was genuinely cold before starting','Cold start and smoke were observed','Loaded operating temperature was recorded','Maximum loaded rpm was checked','Oil, coolant and exhaust-water leaks were checked','Service invoices support the claimed history','Gearbox or drive and propeller history were checked'].map((item) => <label><input type="checkbox" name={item} /> <span>{item}</span></label>)}</div><label>Risks and follow-up tests<textarea name="notes" rows="4"></textarea></label><div class="tool-actions"><button type="button" data-download>Download scorecard</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>

  <section class="owner-tool" id="service-log" data-tool="service-log"><h2>Service log entry</h2><div class="tool-grid"><label>Date<input type="date" name="date" /></label><label>Engine hours<input name="hours" inputmode="decimal" /></label><label>Work performed<input name="work" /></label><label>Parts and fluids<input name="parts" /></label><label>Technician / owner<input name="person" /></label><label>Next due date or hours<input name="next" /></label></div><label>Readings and observations<textarea name="notes" rows="4"></textarea></label><div class="tool-actions"><button type="button" data-download>Download log entry</button><button type="button" data-print>Print</button><button type="button" data-reset>Reset</button></div><p class="tool-status" aria-live="polite"></p></section>
</Page>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-tool]');
  const fields = (section: HTMLElement) => [...section.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
  const serialise = (section: HTMLElement) => fields(section).map((field) => ({ name: field.name, value: field.type === 'checkbox' ? String((field as HTMLInputElement).checked) : field.value }));
  sections.forEach((section) => {
    const key = `marine-diesel-tool:${section.dataset.tool}`;
    try { const saved = JSON.parse(localStorage.getItem(key) || '[]'); saved.forEach((item: {name:string,value:string}) => { const field = fields(section).find((input) => input.name === item.name); if (field) field.type === 'checkbox' ? ((field as HTMLInputElement).checked = item.value === 'true') : (field.value = item.value); }); } catch {}
    section.querySelector('[data-save]')?.addEventListener('click', () => { localStorage.setItem(key, JSON.stringify(serialise(section))); const status = section.querySelector('.tool-status'); if (status) status.textContent = 'Saved on this device.'; });
    section.querySelector('[data-reset]')?.addEventListener('click', () => { fields(section).forEach((field) => field.type === 'checkbox' ? ((field as HTMLInputElement).checked = false) : (field.value = '')); localStorage.removeItem(key); const status = section.querySelector('.tool-status'); if (status) status.textContent = 'Cleared.'; });
    section.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    section.querySelector('[data-download]')?.addEventListener('click', () => { const title = section.querySelector('h2')?.textContent || 'Marine diesel record'; const body = serialise(section).map(({name,value}) => `${name}: ${value}`).join('\n'); const blob = new Blob([`${title}\n${new Date().toLocaleDateString('en-AU')}\n\n${body}\n`], {type:'text/plain'}); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${section.dataset.tool}.txt`; link.click(); URL.revokeObjectURL(link.href); });
  });
</script>
