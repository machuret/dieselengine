---
import site from '../../site.config.json' with { type: 'json' };
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {site.shortName}</title>
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#0d6273" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;650&display=swap" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <Masthead />
    <main id="main">
      <section class="hero">
        <span class="eyebrow">404</span>
        <h1>That page isn't here.</h1>
        <p>It may have moved, or it may never have existed. Try one of these.</p>
      </section>
      <ul class="chips wrap">
        <li><a href="/marine-engine-problems/">Engine problems and symptoms</a></li>
        <li><a href="/costs/">What the work costs</a></li>
        <li><a href="/services/">Marine engine services</a></li>
        <li><a href="/marine-diesel-engines/">How marine diesels work</a></li>
        <li><a href="/engine-brands/">Engine brands</a></li>
        <li><a href="/find-a-marine-mechanic/">Find a mechanic</a></li>
      </ul>
    </main>
    <SiteFooter />
  </body>
</html>
