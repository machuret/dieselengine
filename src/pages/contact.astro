---
import Page from '../layouts/Page.astro';
import site from '../../site.config.json' with { type: 'json' };

const subject = `${site.name} website enquiry`;
const page = {
  url: '/contact/', title: 'Contact Marine Diesel Engine', seoTitle: 'Contact MarineDieselEngine.com.au',
  pageType: 'contact', status: 'ready', author: site.defaultAuthor,
  reviewer: null, needsReviewer: false, parent: '/', parentTitle: 'Home',
  schema: ['ContactPage', 'BreadcrumbList'], updated: site.legalUpdated,
  indexable: true, blockers: [], headings: [], faqs: [],
  description: 'Contact MarineDieselEngine.com.au to report technical errors, request a marine business listing correction or send feedback about an engine guide.',
  primaryKeyword: 'contact MarineDieselEngine.com.au', searchIntent: 'Navigational',
};
---
<Page page={page}>
  <h1>Contact MarineDieselEngine.com.au</h1>
  <p>
    Report an error, suggest a useful source, or request a business-listing
    correction. We cannot diagnose an engine from a message and we do not book
    repairs.
  </p>

  <div data-paperform-id="yousail"></div>
  <script is:inline>
    (function() {
      var script = document.createElement('script');
      script.src = 'https://paperform.co/__embed.min.js';
      document.body.appendChild(script);
    })();
  </script>
  <p class="form-note">
    You can also email
    <a href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(subject)}`}>{site.contactEmail}</a>.
  </p>
</Page>
