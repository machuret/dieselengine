---
import site from '../../site.config.json' with { type: 'json' };
import { seoTitle } from '../lib/extract.js';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Related from '../components/Related.astro';
import Children from '../components/Children.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import StateRules from '../components/StateRules.astro';
import HowToFor from '../components/HowToFor.astro';
import NextSteps from '../components/NextSteps.astro';
import BrandIdentity from '../components/BrandIdentity.astro';
import BrandDirectory from '../components/BrandDirectory.astro';

const { page } = Astro.props;
const canonical = new URL(page.url, site.domain).href;
const description = page.description || site.description;
const socialImage = new URL(site.socialImage, site.domain).href;
const schemaType = page.schema.includes('TechArticle')
  ? 'TechArticle'
  : page.schema.includes('ContactPage')
    ? 'ContactPage'
    : page.schema.includes('CollectionPage')
      ? 'CollectionPage'
      : page.schema.includes('WebPage')
        ? 'WebPage'
        : 'Article';
const headings = page.headings ?? [];
const showToc = headings.length >= 4;

const crumbs = [
  { name: 'Home', url: '/' },
  ...(page.parent && page.parent !== '/'
    ? [{ name: page.parentTitle ?? 'Section', url: page.parent }]
    : []),
  { name: page.title, url: page.url },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': schemaType,
      '@id': `${canonical}#article`,
      name: page.title,
      ...(['Article', 'TechArticle'].includes(schemaType) ? { headline: page.title } : {}),
      description,
      url: canonical,
      image: socialImage,
      inLanguage: site.locale,
      isAccessibleForFree: true,
      ...(page.updated ? { dateModified: page.updated } : {}),
      ...(page.author ? { author: { '@type': 'Organization', name: page.author } } : {}),
      ...(page.reviewer ? { reviewedBy: { '@type': 'Person', name: page.reviewer } } : {}),
      publisher: { '@id': `${site.domain}/#publisher` },
      ...(page.geo
        ? {
            about: { '@id': `${canonical}#place` },
            spatialCoverage: { '@id': `${canonical}#place` },
          }
        : {}),
    },
    ...(page.steps?.length
      ? [{
          '@type': 'HowTo',
          '@id': `${canonical}#howto`,
          name: page.title,
          description,
          inLanguage: site.locale,
          step: page.steps.map((s, i) => ({
            '@type': 'HowToStep',
            position: i + 1,
            name: s.name,
            text: s.text,
            url: `${canonical}#step-${i + 1}`,
          })),
        }]
      : []),
    {
      '@type': 'Organization',
      '@id': `${site.domain}/#publisher`,
      name: site.name,
      url: site.domain,
      description: site.description,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', site.domain).href },
      creator: { '@type': 'Organization', name: 'YouSail.com.au' },
    },
    // A location hub is about a place; say so in a way a machine can read.
    ...(page.geo
      ? [{
          '@type': 'Place',
          '@id': `${canonical}#place`,
          name: page.geo.city,
          address: {
            '@type': 'PostalAddress',
            addressLocality: page.geo.locality,
            addressRegion: page.geo.state,
            postalCode: page.geo.postcode,
            addressCountry: 'AU',
          },
          geo: {
            '@type': 'GeoCoordinates',
            latitude: page.geo.lat,
            longitude: page.geo.lon,
          },
        }]
      : []),
    ...(page.faqs?.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          mainEntity: page.faqs.map((f) => ({
            '@type': 'Question',
            name: f.question,
            acceptedAnswer: { '@type': 'Answer', text: f.answer },
          })),
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.url, site.domain).href,
      })),
    },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.seoTitleTag ?? seoTitle(page, site.shortName)}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {page.indexable
      ? <meta name="robots" content="index, follow, max-image-preview:large" />
      : <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0d6273" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Marine diesel engine installed in a yacht engine bay" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />

    {!page.indexable && (
      <div class="draft-banner" role="status">
        <strong>Draft.</strong> This page has not cleared its publish checks, so it
        is served <code>noindex</code> and is not in the sitemap.
        <ul>{page.blockers.map((b) => <li>{b}</li>)}</ul>
      </div>
    )}

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((c, i) => (
          <li>
            {i < crumbs.length - 1
              ? <a href={c.url}>{c.name}</a>
              : <span aria-current="page">{c.name}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <main id="main">
      <div class="layout">
        <article class="prose">
          {(page.pageType === 'brand-hub' || page.pageType === 'distributor') && <BrandIdentity page={page} />}
          <slot />
          {page.pageType === 'city-hub' && <StateRules state={page.geo?.state} />}
          {page.pageType === 'city-hub' && <ServiceIndex city={page.geo?.city} />}
          <HowToFor page={page} />
          {page.url === '/engine-brands/'
            ? <BrandDirectory />
            : <Children page={page} />}
          <NextSteps page={page} />
          <Related page={page} />
          <footer class="byline">
            {page.author
              ? <p>Written by {page.author}{page.reviewer ? `. Technically reviewed by ${page.reviewer}.` : ''}</p>
              : <p>Author not yet assigned.</p>}
            {page.updated && <p>Last updated {page.updated}.</p>}
            <p>We are an independent resource. We do not work on boats.</p>
            <p><strong>Important:</strong> General information can be incomplete or wrong. Read our <a href="/disclaimer/">full disclaimer</a>.</p>
          </footer>
        </article>

        {showToc && (
          <aside class="side">
            <p class="toc-title"><span class="rule-dash" aria-hidden="true"></span>On this page</p>
            <nav class="toc" aria-label="On this page">
              <ul>
                {headings.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
