---
import site from '../../site.config.json' with { type: 'json' };
const { page } = Astro.props;
const canonical = new URL(page.url, site.domain).href;

// Take the page's first paragraph as the meta description.
const description = (page.description ?? site.description).slice(0, 300);

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': page.schema.includes('TechArticle') ? 'TechArticle' : 'Article',
      '@id': `${canonical}#article`,
      headline: page.title,
      description,
      url: canonical,
      inLanguage: site.locale,
      isAccessibleForFree: true,
      ...(page.updated ? { dateModified: page.updated } : {}),
      ...(page.author ? { author: { '@type': 'Person', name: page.author } } : {}),
      ...(page.reviewer
        ? { reviewedBy: { '@type': 'Person', name: page.reviewer } }
        : {}),
      publisher: { '@id': `${site.domain}/#publisher` },
    },
    {
      '@type': 'Organization',
      '@id': `${site.domain}/#publisher`,
      name: site.name,
      url: site.domain,
      description: site.description,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.domain}/` },
        ...(page.parent && page.parent !== '/'
          ? [{
              '@type': 'ListItem',
              position: 2,
              name: page.parentTitle ?? 'Section',
              item: new URL(page.parent, site.domain).href,
            }]
          : []),
        {
          '@type': 'ListItem',
          position: page.parent && page.parent !== '/' ? 3 : 2,
          name: page.title,
          item: canonical,
        },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} | {site.shortName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Anything that has not cleared the publish gates must not be indexed. */}
    {page.indexable
      ? <meta name="robots" content="index, follow, max-image-preview:large" />
      : <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="brand" href="/">{site.shortName}</a>
      <nav aria-label="Primary">
        <a href="/diesel-engines/">Diesel engines</a>
        <a href="/diesel-problems/">Problems</a>
        <a href="/services/">Services</a>
        <a href="/costs/">Costs</a>
        <a href="/find-a-diesel-mechanic/">Find a mechanic</a>
      </nav>
    </header>

    {!page.indexable && (
      <div class="draft-banner" role="status">
        <strong>Draft.</strong> This page has not cleared its publish checks, so it
        is served <code>noindex</code> and is not in the sitemap.
        <ul>{page.blockers.map((b) => <li>{b}</li>)}</ul>
      </div>
    )}

    <main id="main">
      <article class="prose"><slot /></article>
      <footer class="byline">
        {page.author
          ? <p>Written by {page.author}{page.reviewer ? `. Technically reviewed by ${page.reviewer}.` : ''}</p>
          : <p class="muted">Author and reviewer not yet assigned.</p>}
        {page.updated && <p class="muted">Last updated {page.updated}.</p>}
      </footer>
    </main>

    <footer class="site">
      <p>
        <strong>{site.name}</strong> is an independent information site. We do not
        repair vehicles, sell parts, or perform any of the work described here.
      </p>
      <p class="muted">
        Information is general in nature. Always have diesel faults diagnosed by a
        licensed mechanic.
      </p>
    </footer>
  </body>
</html>
