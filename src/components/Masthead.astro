---
import site from '../../site.config.json' with { type: 'json' };
---
<header class="site">
  <a class="brand" href="/">
    {/* A propeller-and-water mark: specific to marine, no anchors or rope. */}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="2.1" fill="currentColor" />
      <path d="M12 9.6c0-3 .9-5.4 2.6-6.2 1.6-.8 3 .6 3 2.5 0 2.4-2.4 3.7-5.6 3.7Z"
            fill="currentColor" opacity=".85" />
      <path d="M9.9 13.2c-2.6 1.5-5.1 1.9-6.3.7-1.2-1.2-.5-3.1 1.2-4 2-1.1 4.2.5 5.1 3.3Z"
            fill="currentColor" opacity=".6" />
      <path d="M14.1 13.2c2.6 1.5 4 3.6 3.4 5.2-.6 1.6-2.6 1.8-4.2.8-2-1.2-2.1-3.9-.8-6Z"
            fill="currentColor" opacity=".45" />
      <path d="M2 21c1.6 0 1.6-1.2 3.2-1.2S6.8 21 8.4 21s1.6-1.2 3.2-1.2S13.2 21 14.8 21s1.6-1.2 3.2-1.2S19.6 21 22 21"
            stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".45" />
    </svg>
    {site.shortName}
  </a>
  <nav aria-label="Primary">
    <a href="/marine-diesel-engines/">Marine engines</a>
    <a href="/marine-engine-problems/">Problems</a>
    <a href="/services/">Services</a>
    <a href="/costs/">Costs</a>
    <a href="/buy-marine-diesel-engine/">Buy an engine</a>
    <a href="/find-a-marine-mechanic/">Find a mechanic</a>
  </nav>
</header>
