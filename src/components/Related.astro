---
import { allPages } from '../lib/content.js';
import { questionClusters } from '../lib/questions.js';

/**
 * Automatic related links.
 *
 * The plan asks every page to link sideways as well as up and down, which is
 * not maintainable by hand across 1,279 planned pages. This derives the links
 * from the source data the pages were generated from: a service page relates to
 * its own cluster (cooling, fuel, driveline), and a location relates to the
 * ones actually nearest to it by coordinates. Word-overlap guessing produced
 * plausible-looking but wrong pairings, which is worse than none.
 */
const { page } = Astro.props;

let crossLink = null;
const published = allPages.filter((p) => p.indexable && p.url !== page.url);
let related = [];

if (page.pageType === 'service-national' && page.cluster) {
  const sameCluster = published.filter(
    (p) => p.pageType === 'service-national' && p.cluster === page.cluster
  );
  const others = published.filter(
    (p) => p.pageType === 'service-national' && p.cluster !== page.cluster
  );
  related = [...sameCluster, ...others].slice(0, 6);
} else if (page.geo) {
  const km = (a, b) => {
    const R = 6371, r = Math.PI / 180;
    const dLat = (b.lat - a.lat) * r, dLon = (b.lon - a.lon) * r;
    const h = Math.sin(dLat / 2) ** 2 +
      Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  };
  const here = { lat: +page.geo.lat, lon: +page.geo.lon };
  const nearby = published
    .filter((p) => p.pageType === page.pageType && p.geo)
    .map((p) => ({ p, d: km(here, { lat: +p.geo.lat, lon: +p.geo.lon }) }))
    .sort((a, b) => a.d - b.d)
    .slice(0, 4)
    .map((x) => x.p);
  // The two place families answer different halves of the same question —
  // where to buy an engine here, and who can fit it — so each links across to
  // its counterpart for the same region before listing neighbours.
  const counterpart = published.find(
    (p) => p.geo?.slug === page.geo.slug && p.pageType !== page.pageType
  );
  crossLink = counterpart ?? null;
  related = nearby;
} else if (page.pageType === 'decision' && page.cluster) {
  const sameCluster = published.filter(
    (p) => p.pageType === 'decision' && p.cluster === page.cluster
  );
  const others = published.filter(
    (p) => p.pageType === 'decision' && p.cluster !== page.cluster
  );
  related = [...sameCluster, ...others].slice(0, 6);
} else {
  related = published.filter((p) => p.pageType === page.pageType).slice(0, 5);
}

const cluster = questionClusters.find((c) => c.match.test(page.url));
const strip = (t) =>
  t.replace(' in Australia', '').replace('Marine Diesel Mechanics in ', '');
const label = page.geo ? 'Nearby' : 'Related';
---
{(related.length > 0 || crossLink) && (
  <nav class="related" aria-label={`${label} pages`}>
    <h2>{label}</h2>
    <ul>
      {crossLink && <li><a href={crossLink.url}>{crossLink.title}</a></li>}
      {related.map((p) => <li><a href={p.url}>{strip(p.title)}</a></li>)}
      {cluster && (
        <li><a href={`/questions/${cluster.slug}/`}>Questions: {cluster.title.toLowerCase()}</a></li>
      )}
    </ul>
  </nav>
)}
