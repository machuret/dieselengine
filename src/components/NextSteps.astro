---
const { page } = Astro.props;

const common = {
  symptoms: { url: '/marine-engine-problems/', title: 'Start from an engine symptom' },
  services: { url: '/services/', title: 'Understand the repair or service' },
  costs: { url: '/costs/', title: 'Check Australian cost guidance' },
  mechanic: { url: '/find-a-marine-mechanic/', title: 'Prepare to find a marine mechanic' },
  identify: { url: '/how/how-to-identify-your-marine-engine/', title: 'Identify your engine and serial number' },
  schedule: { url: '/guides/marine-engine-service-schedule/', title: 'Review the service schedule' },
  buying: { url: '/buy-marine-diesel-engine/', title: 'Compare buying and repower options' },
  resources: { url: '/resources/', title: 'Open manuals and authority resources' },
  maintenance: { url: '/guides/marine-diesel-maintenance-checklist/', title: 'Use the maintenance checklist' },
  inspection: { url: '/guides/marine-engine-room-inspection-checklist/', title: 'Run the engine-room inspection' },
  parts: { url: '/guides/marine-diesel-parts-explained/', title: 'Learn the parts around the engine' },
  hours: { url: '/guides/marine-engine-hours-explained/', title: 'Understand engine hours and condition' },
  emergency: { url: '/guides/emergency-engine-shutdown/', title: 'Know when to shut the engine down' },
};

let links = [];
if (page.pageType === 'service-national') {
  links = [common.maintenance, common.costs, common.mechanic, common.resources];
} else if (page.pageType === 'brand-hub' || page.pageType === 'distributor') {
  links = [common.identify, common.schedule, common.buying, common.mechanic];
} else if (page.pageType === 'symptom') {
  links = [common.emergency, common.parts, common.services, common.mechanic];
} else if (page.pageType === 'howto') {
  links = [common.inspection, common.symptoms, common.services, common.resources];
} else if (page.geo) {
  links = [common.inspection, common.costs, common.services, common.mechanic];
} else if (page.pageType === 'boat-brand') {
  links = [common.identify, common.hours, common.buying, common.schedule];
} else if (page.pageType === 'decision') {
  links = [common.maintenance, common.inspection, common.costs, common.resources];
}

links = links.filter((link) => link.url !== page.url);
---
{links.length > 0 && (
  <nav class="next-steps" aria-label="Useful next steps">
    <p class="next-label">Useful next steps</p>
    <ul>
      {links.map((link) => <li><a href={link.url}>{link.title}<span aria-hidden="true">→</span></a></li>)}
    </ul>
  </nav>
)}
