---
import { allPages } from '../lib/content.js';

/**
 * Down-links from a hub to everything published beneath it.
 *
 * Pillars were linking to only the handful of children that happened to be
 * named in their prose, so most guides had no path down from their own parent.
 * Deriving it from `parent` keeps the hub complete as pages are added.
 */
const { page } = Astro.props;

// A regional hub's job is to route, and its spokes live under other parents
// (/marine-mechanics/, /buy-marine-diesel-engine/, /services/...). So it
// gathers by region rather than by parent — that routing IS the page's
// purpose, and without it the hub is a dead end for the head term it owns.
const isRegionHub = page.pageType === 'region-hub' && page.geo;
const children = allPages
  .filter((p) => {
    if (!p.indexable || p.url === page.url) return false;
    if (isRegionHub) return p.geo?.slug === page.geo.slug;
    return p.parent === page.url;
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const groups = new Map();
for (const c of children) {
  const key = isRegionHub ? c.pageType : (c.cluster ?? '');
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(c);
}
const LABELS = {
  'city-hub': 'Find a mechanic here',
  'buying-city': 'Buying an engine here',
  cost: 'What it costs',
  comparison: 'Choosing between options',
  'buyers-guide': 'Before you book',
  compliance: 'Rules and rights',
  education: 'How it works',
};
const grouped = [...groups.entries()].filter(([k]) => LABELS[k]);
const useGroups = grouped.length > 1 && grouped.flatMap(([, v]) => v).length === children.length;
---
{children.length > 0 && (
  <nav class="related children" aria-label="In this section">
    <h2>{isRegionHub ? 'In this region' : 'In this section'}</h2>
    {useGroups ? grouped.map(([key, items]) => (
      <>
        <p class="children-group">{LABELS[key]}</p>
        <ul>{items.map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>
      </>
    )) : <ul>{children.map((c) => <li><a href={c.url}>{c.title}</a></li>)}</ul>}
  </nav>
)}
